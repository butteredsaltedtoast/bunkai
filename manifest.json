{
  "manifest_version": 3,
  "name": "Bunkai",
  "version": "2.0",
  "description": "Highlight Japanese text for a word-by-word breakdown. Now runs fully offline, no API key needed!",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["popup.css"]
    }
  ],
  "action": {
    "default_popup": "settings.html"
  }
}