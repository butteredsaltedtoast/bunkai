{
  "manifest_version": 3,
  "name": "Bunkai",
  "version": "3.0",
  "description": "Highlight Japanese text for a word-by-word breakdown. Now runs fully offline, no API key needed!",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_security_policy" : {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": ["storage", "offscreen", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["popup.css"]
    }
  ],
  "action": {
    "default_popup": "settings.html"
  },
  "commands" : {
    "analyze-selection" : {
      "suggested_key" : {"default": "Alt+B"},
      "description": "Break down the selected Japanese text"
    }
  }
}